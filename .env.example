# Copy to .env for local development. On Vercel, set the same names under Project → Settings → Environment Variables.

# Data driver: "firebase" (production) or "local" (stores data in .data/local; development only)
NUXT_DRIVER=local
# Password for the local driver's admin login
NUXT_LOCAL_ADMIN_PASSWORD=change-me

# Long random strings (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing NUXT_INVITE_SECRET invalidates every invitation link already sent.
NUXT_INVITE_SECRET=
NUXT_SESSION_SECRET=

# Firebase service account (Firebase Console → Project settings → Service accounts → Generate new private key).
# Server-only. Never commit these or expose them to the browser.
NUXT_FIREBASE_PROJECT_ID=ousa-wedding
NUXT_FIREBASE_CLIENT_EMAIL=
NUXT_FIREBASE_PRIVATE_KEY=
NUXT_FIREBASE_STORAGE_BUCKET=ousa-wedding.firebasestorage.app

# Public site URL used in invitation links and share previews, e.g. https://ousawedding.vercel.app
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_DEFAULT_WEDDING_SLUG=our-wedding
