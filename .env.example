# Copy to .env. Used only on your computer, where the admin runs (`npm run dev`).

# Password for the admin dashboard
NUXT_LOCAL_ADMIN_PASSWORD=change-me

# The live site address, used in personal invitation links, QR codes and share previews.
# Set the same variable in Vercel / Netlify so share previews and calendar files use it too.
NUXT_PUBLIC_SITE_URL=https://ousawedding.vercel.app

# Which wedding the site's front page opens
NUXT_PUBLIC_DEFAULT_WEDDING_SLUG=our-wedding
