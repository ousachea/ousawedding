# Copy to .env. Used only on your computer, where the admin runs (`npm run dev`).

# Password for the admin dashboard
NUXT_LOCAL_ADMIN_PASSWORD=change-me

# The live site address, used in personal invitation links, QR codes and share previews.
# Set the same variable in Netlify so share previews and calendar files use it too.
NUXT_PUBLIC_SITE_URL=https://ousawedding.netlify.app

# Which wedding the site's front page opens
NUXT_PUBLIC_DEFAULT_WEDDING_SLUG=ousa-kanha

# Telegram alert for each RSVP from the built-in form. Create a bot with @BotFather, message it,
# then find your chat ID at https://api.telegram.org/bot<token>/getUpdates. Set both in Netlify too (Site configuration → Environment variables).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
